# Copy to /opt/<app>/.env on the server (chmod 600). Never commit the real file.
APP_NAME=erp
DB_NAME=erp
DB_USERNAME=erp
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# At least 32 random characters, e.g. `openssl rand -base64 48`
APP_SECURITY_JWT_SECRET=
APP_SECURITY_SEED_DEFAULT_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=https://erp.example.com
NEXT_PUBLIC_API_BASE_URL=https://erp.example.com
# Optional
NEXT_PUBLIC_MAPBOX_TOKEN=
BACKEND_JAVA_OPTS=-Xms256m -Xmx1024m
# AI assistant (off until enabled per company in Settings > Assistant)
APP_AI_OLLAMA_ENABLED=true
APP_AI_OLLAMA_BASE_URL=http://ollama:11434
APP_AI_OLLAMA_MODEL=qwen2.5:3b
